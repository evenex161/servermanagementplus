{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {},
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.servermanagement.ServerManagementModFabric"
        ],
        "client": [
            "com.servermanagement.client.ClientSetup"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    },
    "mixins": [
        "servermanagement.mixins.json"
    ],
    "accessWidener": "servermanagement.accesswidener"
}
